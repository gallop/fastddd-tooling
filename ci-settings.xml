<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <servers>
    <server>
      <id>fastddd-candidates</id>
      <username>${env.FASTDDD_MAVEN_REPOSITORY_USERNAME}</username>
      <password>${env.FASTDDD_MAVEN_REPOSITORY_PASSWORD}</password>
    </server>
  </servers>
  <profiles>
    <profile>
      <id>fastddd-candidates</id>
      <repositories>
        <repository>
          <id>fastddd-candidates</id>
          <url>${env.FASTDDD_MAVEN_REPOSITORY_URL}</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <activeProfiles><activeProfile>fastddd-candidates</activeProfile></activeProfiles>
</settings>
