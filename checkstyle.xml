<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Incremental baseline for the multi-module repository.  These checks are
  intentionally small but real: they catch cross-platform tab characters and
  unmaintainable source-file growth without imposing a new formatting style on
  legacy code.  Stricter rules are added only with an agreed remediation plan.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <module name="FileTabCharacter"/>
    <module name="FileLength">
        <property name="max" value="2000"/>
    </module>
</module>
