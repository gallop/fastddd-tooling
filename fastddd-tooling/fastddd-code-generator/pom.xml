<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-tooling-parent</artifactId>
        <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fastddd-code-generator</artifactId>
    <packaging>jar</packaging>

    <name>FastDDD Code Generator</name>
    <description>Code generation engine for FastDDD framework</description>

    <dependencies>
        <!-- FastDDD Dependencies -->
        <!-- Tooling 稳定契约层（SPLIT-003）：本模块作为契约的官方实现方，依赖方向 Tooling→API 合规（ADR-005） -->
        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fastddd-tooling-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fast-ddd-common</artifactId>
        </dependency>
        
        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fast-ddd-model</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fastddd-templates</artifactId>
        </dependency>

        <!-- ID-007 步骤 8：生成代码编译期门禁所需——生成的贫血/充血代码引用 fast-ddd-crud
             （BaseRepository/IService/BaseServiceImpl）、fast-ddd-web（BaseController）与
             swagger 注解。test scope，仅编译生成产物时需要；ADR-005 允许 Tooling→Framework 方向。 -->
        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fast-ddd-web</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ID-007 步骤 8：充血生成代码引用 fast-ddd-application（Command/CommandHandler/Query/
             QueryHandler/CommandController/QueryController 基类）。fast-ddd-web 将本模块声明为
             optional，不传递至本模块测试类路径，故显式补 test scope；ADR-005 允许 Tooling→Framework。 -->
        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fast-ddd-application</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MyBatis Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-generator</artifactId>
        </dependency>
        
        <!-- Database -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>
        
        <!-- Spring Boot Configuration Processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        
        <!-- Spring Boot Auto Configuration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MapStruct (optional, for EntityMapper) -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- FreeMarker for template processing -->
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- H2 Database for Testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- Test Containers for Integration Tests -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
