<?xml version="1.0" encoding="UTF-8"?>
<plugin>
    <name>FastDDD Maven Plugin</name>
    <description>FastDDD框架的Maven插件，提供代码生成、数据库文档生成等功能</description>
    <groupId>com.gallop</groupId>
    <artifactId>fastddd-maven-plugin</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <goalPrefix>fastddd</goalPrefix>
    <isolatedRealm>false</isolatedRealm>
    <inheritedByDefault>true</inheritedByDefault>
    
    <mojos>
        <mojo>
            <goal>generate-code</goal>
            <description>根据数据库表生成Java代码</description>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresReports>false</requiresReports>
            <aggregator>false</aggregator>
            <requiresOnline>false</requiresOnline>
            <inheritedByDefault>true</inheritedByDefault>
            <phase>generate-sources</phase>
            <implementation>com.gallop.fastddd.maven.plugin.CodeGenMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <executionStrategy>once-per-session</executionStrategy>
            <threadSafe>false</threadSafe>
            
            <parameters>
                <parameter>
                    <name>url</name>
                    <type>java.lang.String</type>
                    <required>true</required>
                    <editable>true</editable>
                    <description>数据库连接URL</description>
                </parameter>
                <parameter>
                    <name>username</name>
                    <type>java.lang.String</type>
                    <required>true</required>
                    <editable>true</editable>
                    <description>数据库用户名</description>
                </parameter>
                <parameter>
                    <name>password</name>
                    <type>java.lang.String</type>
                    <required>true</required>
                    <editable>true</editable>
                    <description>数据库密码</description>
                </parameter>
                <parameter>
                    <name>basePackage</name>
                    <type>java.lang.String</type>
                    <required>true</required>
                    <editable>true</editable>
                    <description>基础包名</description>
                </parameter>
                <parameter>
                    <name>outputDir</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>输出目录</description>
                </parameter>
            </parameters>
        </mojo>
        
        <mojo>
            <goal>generate-doc</goal>
            <description>生成数据库文档</description>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresReports>false</requiresReports>
            <aggregator>false</aggregator>
            <requiresOnline>false</requiresOnline>
            <inheritedByDefault>true</inheritedByDefault>
            <phase>generate-resources</phase>
            <implementation>com.gallop.fastddd.maven.plugin.FastDocMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <executionStrategy>once-per-session</executionStrategy>
            <threadSafe>false</threadSafe>
            
            <parameters>
                <parameter>
                    <name>url</name>
                    <type>java.lang.String</type>
                    <required>true</required>
                    <editable>true</editable>
                    <description>数据库连接URL</description>
                </parameter>
                <parameter>
                    <name>username</name>
                    <type>java.lang.String</type>
                    <required>true</required>
                    <editable>true</editable>
                    <description>数据库用户名</description>
                </parameter>
                <parameter>
                    <name>password</name>
                    <type>java.lang.String</type>
                    <required>true</required>
                    <editable>true</editable>
                    <description>数据库密码</description>
                </parameter>
                <parameter>
                    <name>outputDir</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>输出目录</description>
                </parameter>
                <parameter>
                    <name>format</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>输出格式</description>
                </parameter>
            </parameters>
        </mojo>
        
        <mojo>
            <goal>help</goal>
            <description>显示帮助信息</description>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>false</requiresProject>
            <requiresReports>false</requiresReports>
            <aggregator>false</aggregator>
            <requiresOnline>false</requiresOnline>
            <inheritedByDefault>true</inheritedByDefault>
            <implementation>com.gallop.fastddd.maven.plugin.HelpMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <executionStrategy>once-per-session</executionStrategy>
            <threadSafe>true</threadSafe>
            
            <parameters>
                <parameter>
                    <name>detail</name>
                    <type>boolean</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>显示详细信息</description>
                </parameter>
                <parameter>
                    <name>goal</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>显示指定目标的帮助信息</description>
                </parameter>
            </parameters>
        </mojo>
    </mojos>
    
    <dependencies>
        <dependency>
            <groupId>com.gallop</groupId>
            <artifactId>fast-ddd-core</artifactId>
            <type>jar</type>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.gallop</groupId>
            <artifactId>fast-ddd-web</artifactId>
            <type>jar</type>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.gallop</groupId>
            <artifactId>fastddd-code-generator</artifactId>
            <type>jar</type>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
    </dependencies>
</plugin>