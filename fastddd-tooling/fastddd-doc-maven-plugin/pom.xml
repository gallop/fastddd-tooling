<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-tooling-parent</artifactId>
        <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fastddd-doc-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <name>FastDDD Doc Maven Plugin</name>
    <description>Maven plugin for generating API documentation from Spring Boot controllers</description>

    <properties>
        <maven.version>3.9.5</maven.version>
        <maven-plugin-annotations.version>3.10.2</maven-plugin-annotations.version>
        <maven-plugin-plugin.version>3.10.2</maven-plugin-plugin.version>
    </properties>

    <prerequisites>
        <maven>3.9.5</maven>
    </prerequisites>

    <dependencies>
        <!-- Maven Plugin API -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven-plugin-annotations.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- FastDDD Doc Generator -->
        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fastddd-doc-generator</artifactId>
        </dependency>

        <!-- L4 模板国际化：DocGenMojo 直接装配 TemplateMessages（显式声明，避免仅经传递依赖解析） -->
        <dependency>
            <groupId>io.github.gallop.fastddd</groupId>
            <artifactId>fastddd-templates</artifactId>
        </dependency>

        <!-- Spring Boot (for loading Spring context if needed) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- SLF4J Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Plugin Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>3.10.2</version>
                <configuration>
                    <goalPrefix>fastdoc</goalPrefix>
                </configuration>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <phase>process-classes</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- Skip Spring Boot plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
