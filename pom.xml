<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.gallop.fastddd</groupId>
  <artifactId>fastddd-tooling-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>FastDDD Tooling</name>
  <description>FastDDD code generation, templates, documentation and Maven tooling</description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <organization>
    <name>gallop-group</name>
  </organization>
  <developers>
    <developer>
      <id>gallop</id>
      <name>Gallop</name>
      <email>39100782@qq.com</email>
    </developer>
  </developers>
  <url>https://github.com/gallop/fastddd-tooling</url>
  <scm>
    <connection>scm:git:https://github.com/gallop/fastddd-tooling.git</connection>
    <developerConnection>scm:git:git@github.com:gallop/fastddd-tooling.git</developerConnection>
    <url>https://github.com/gallop/fastddd-tooling</url>
  </scm>
  <properties>
    <!-- CI-friendly 版本：reactor 唯一版本入口，发布时由 flatten-maven-plugin 解析为字面量 -->
    <revision>1.0.0-SNAPSHOT</revision>
    <!-- 已发布 Framework BOM 版本；与 Tooling 自身 revision 独立演进。
         2026-10-12 T8.55：Framework 1.0.2 语义扩列消费（TableMetadata 三可空列）——本地 install 测试态 -->
    <fastddd-framework.version>1.0.2</fastddd-framework.version>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Spring Boot -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- Spring AI -->
    <spring-ai.version>1.1.8</spring-ai.version>
    <!-- Database -->
    <mybatis-plus.version>3.5.12</mybatis-plus.version>
    <mybatis-spring.version>3.0.4</mybatis-spring.version>
    <druid.version>1.2.28</druid.version>
    <!-- Cache -->
    <!-- Message Queue -->
    <rocketmq.version>2.2.3</rocketmq.version>
    <!-- Search -->
    <elasticsearch.version>8.11.0</elasticsearch.version>
    <!-- Documentation -->
    <springdoc.version>2.8.17</springdoc.version>
    <knife4j.version>4.5.0</knife4j.version>
    <!-- Utilities -->
    <hutool.version>5.8.34</hutool.version>
    <mapstruct.version>1.5.5.Final</mapstruct.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <!-- Code Generation & Documentation -->
    <javaparser.version>3.25.1</javaparser.version>
    <!-- Security -->
    <jjwt.version>0.11.5</jjwt.version>
    <!-- Logging -->
    <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>
    <!-- Utilities (additional) -->
    <zip4j.version>2.11.5</zip4j.version>
    <!-- Build Tools -->
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <maven-jar-plugin.version>3.3.0</maven-jar-plugin.version>
    <maven-surefire-plugin.version>3.2.2</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.2.2</maven-failsafe-plugin.version>
    <!-- 默认生命周期插件显式 pin（满足 enforcer requirePluginVersions，行为同 Maven 3.9.5 内置默认） -->
    <maven-clean-plugin.version>3.2.0</maven-clean-plugin.version>
    <maven-install-plugin.version>3.1.1</maven-install-plugin.version>
    <maven-site-plugin.version>3.12.1</maven-site-plugin.version>
    <maven-deploy-plugin.version>3.1.1</maven-deploy-plugin.version>
    <checkstyle-plugin.version>3.3.1</checkstyle-plugin.version>
    <jacoco-plugin.version>0.8.11</jacoco-plugin.version>
    <pmd-plugin.version>3.24.0</pmd-plugin.version>
    <spotbugs-plugin.version>4.8.2.0</spotbugs-plugin.version>
    <findsecbugs-plugin.version>1.12.0</findsecbugs-plugin.version>
    <sonar-plugin.version>3.10.0.2594</sonar-plugin.version>
    <!-- 治理插件 -->
    <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.10.1</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    <!-- 消费者测试隔离 harness（FRM-002），显式 pin 满足 enforcer requirePluginVersions -->
    <maven-invoker-plugin.version>3.9.0</maven-invoker-plugin.version>
    <!-- Profile-specific properties (defaults) -->
    <profile.active>dev</profile.active>
    <logging.level.root>INFO</logging.level.root>
    <logging.level.com.gallop.fastddd>DEBUG</logging.level.com.gallop.fastddd>
    <database.url>jdbc:h2:mem:testdb</database.url>
    <database.username>sa</database.username>
    <database.password/>
    <redis.host>localhost</redis.host>
    <redis.port>6379</redis.port>
    <enable.swagger>true</enable.swagger>
    <enable.actuator>true</enable.actuator>
  </properties>
  <modules>
    <!-- 工具层 -->
    <module>fastddd-tooling</module>
    <!-- Tooling 自有的外部消费者契约测试，不进入发布制品。 -->
    <module>fastddd-tooling-consumer-tests</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <!--
        VER-001 Phase A：单一依赖来源——根 pom import fastddd-bom，消除根 pom 与 BOM 的 depMgmt 重复。
        fastddd-bom 为发布自洽的独立 POM（无 parent，不泄漏 profile/环境属性），import 仅带入 depMgmt。
        Framework BOM 使用独立的 fastddd-framework.version；Tooling 自模块继续随本仓 revision。
        校验见 VersionGovernanceContractTest（上游版本解耦 + Tooling 内部版本完整性 + 兼容矩阵）。
      -->
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-bom</artifactId>
        <version>${fastddd-framework.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        Tooling 已物理拆仓，Framework BOM 只管理 Framework 坐标。
        本仓模块之间的无版本依赖统一绑定到本仓 revision，保证 RC/GA 覆盖版本时
        fastdoc、生成器及 Maven 插件能够作为独立 reactor 构建。
      -->
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-tooling-api</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-templates</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-fastdoc-core</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-fastdoc-spring-boot-starter</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-code-generator</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-doc-generator</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-maven-plugin</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-doc-maven-plugin</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>io.github.gallop.fastddd</groupId>
        <artifactId>fastddd-project-archetype</artifactId>
        <version>${revision}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${java.version}</release>
            <encoding>${project.build.sourceEncoding}</encoding>
            <parameters>true</parameters>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </path>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- 版本治理属性以"有效构建值"（含 -D 覆盖）进入测试 JVM：
                 契约测试经 System.getProperty 优先读取，区分覆盖构建（RC/合成差异化验证）
                 与 POM 文件默认线。此处 ${...} 在构建期插值为 session 值，两种场景皆正确。 -->
            <systemPropertyVariables>
              <revision>${revision}</revision>
              <fastddd-framework.version>${fastddd-framework.version}</fastddd-framework.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${checkstyle-plugin.version}</version>
          <configuration>
            <configLocation>checkstyle.xml</configLocation>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <failOnViolation>true</failOnViolation>
            <consoleOutput>true</consoleOutput>
          </configuration>
          <executions>
            <execution>
              <id>validate</id>
              <phase>validate</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>test</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>report-aggregate</id>
              <phase>verify</phase>
              <goals>
                <goal>report-aggregate</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>${pmd-plugin.version}</version>
          <configuration>
            <targetJdk>${java.version}</targetJdk>
            <includeTests>true</includeTests>
            <rulesets>
              <ruleset>/category/java/bestpractices.xml</ruleset>
              <ruleset>/category/java/codestyle.xml</ruleset>
              <ruleset>/category/java/design.xml</ruleset>
              <ruleset>/category/java/errorprone.xml</ruleset>
              <ruleset>/category/java/performance.xml</ruleset>
              <ruleset>/category/java/security.xml</ruleset>
            </rulesets>
            <excludeRoots>
              <excludeRoot>target/generated-sources</excludeRoot>
              <excludeRoot>target/generated-test-sources</excludeRoot>
            </excludeRoots>
            <failOnViolation>false</failOnViolation>
            <printFailingErrors>true</printFailingErrors>
          </configuration>
          <executions>
            <execution>
              <id>pmd-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-plugin.version}</version>
          <configuration>
            <effort>Max</effort>
            <threshold>Medium</threshold>
            <includeTests>true</includeTests>
            <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
            <failOnError>false</failOnError>
            <xmlOutput>true</xmlOutput>
            <spotbugsXmlOutput>true</spotbugsXmlOutput>
            <plugins>
              <plugin>
                <groupId>com.h3xstream.findsecbugs</groupId>
                <artifactId>findsecbugs-plugin</artifactId>
                <version>${findsecbugs-plugin.version}</version>
              </plugin>
            </plugins>
          </configuration>
          <executions>
            <execution>
              <id>spotbugs-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar-plugin.version}</version>
        </plugin>
        <!-- 默认生命周期插件显式版本（满足 enforcer requirePluginVersions） -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <!-- Resource filtering configuration -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/*.yml</include>
          <include>**/*.yaml</include>
          <include>**/*.properties</include>
        </includes>
        <excludes>
          <!-- L4 文案字典按原文打包：含边界空格转义与嵌套 FTL 引用示意，不经 Maven 过滤 -->
          <exclude>messages/**</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/*.yml</exclude>
          <exclude>**/*.yaml</exclude>
          <exclude>**/*.properties</exclude>
        </excludes>
      </resource>
      <!-- L4 文案字典按原文打包：含边界空格转义与嵌套 FTL 引用示意，不经 Maven 过滤
           （单独成块：同一 resource 内 excludes 优先于 includes，不能与 **/*.properties 排除混写） -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>messages/**</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>include-community-legal-files</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
              <resources>
                <resource>
                  <directory>${maven.multiModuleProjectDirectory}</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <!-- CI-friendly 版本：发布 POM 中 ${revision} 解析为字面量（resolveCiFriendliesOnly 模式侵入性最低） -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <!-- oss 模式：解析全部属性为字面量（含命令行 -D 覆盖值）。
               此前 resolveCiFriendliesOnly 只解析 revision/sha1/changeList，fastddd-framework.version
               属自定义属性，部署 POM 的 BOM import 仍指向属性默认值（SNAPSHOT），下游消费方在
               snapshots 关闭的 release 仓无法解析 descriptor（GA 门禁 fastdoc-minimal 拦截项）。 -->
          <flattenMode>oss</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- 构建前置门禁：JDK 21+、Maven 3.9.x、插件版本显式、禁止重复依赖 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-versions</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.0,4.0.0)</version>
                </requireMavenVersion>
                <!-- enforcer 3.5.0 规则名为 requirePluginVersions（旧名 requireExplicitPluginVersions 已移除）；
                     默认 ban LATEST/RELEASE/时间戳版本，允许 SNAPSHOT；插件版本须显式或经 pluginManagement 提供。 -->
                <requirePluginVersions/>
                <banDuplicatePomDependencyVersions/>
                <bannedDependencies>
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>com.gallop.fastddd:fastddd-studio*</exclude>
                    <exclude>com.gallop.fastagent:*</exclude>
                  </excludes>
                  <message>Tooling Community 允许依赖 Framework，但禁止依赖 Studio Pro 或 FastAgent。</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Development Profile -->
    <profile>
      <id>dev</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <spring.profiles.active>dev</spring.profiles.active>
        <profile.active>dev</profile.active>
        <logging.level.root>INFO</logging.level.root>
        <logging.level.com.gallop.fastddd>DEBUG</logging.level.com.gallop.fastddd>
        <database.url>jdbc:mysql://localhost:3306/fastddd?useUnicode=true&amp;characterEncoding=utf8&amp;serverTimezone=Asia/Shanghai&amp;allowPublicKeyRetrieval=true</database.url>
        <database.username>root</database.username>
        <database.password>123456</database.password>
        <redis.host>localhost</redis.host>
        <redis.port>6379</redis.port>
        <enable.swagger>true</enable.swagger>
        <enable.actuator>true</enable.actuator>
      </properties>
    </profile>
    <!-- Test Profile -->
    <profile>
      <id>test</id>
      <properties>
        <spring.profiles.active>test</spring.profiles.active>
        <profile.active>test</profile.active>
        <logging.level.root>WARN</logging.level.root>
        <logging.level.com.gallop.fastddd>INFO</logging.level.com.gallop.fastddd>
        <database.url>jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE</database.url>
        <database.username>sa</database.username>
        <database.password/>
        <redis.host>localhost</redis.host>
        <redis.port>6379</redis.port>
        <enable.swagger>false</enable.swagger>
        <enable.actuator>false</enable.actuator>
      </properties>
    </profile>
    <!-- Production Profile -->
    <profile>
      <id>prod</id>
      <properties>
        <spring.profiles.active>prod</spring.profiles.active>
        <profile.active>prod</profile.active>
        <logging.level.root>WARN</logging.level.root>
        <logging.level.com.gallop.fastddd>INFO</logging.level.com.gallop.fastddd>
        <database.url>jdbc:mysql://localhost:3306/fastddd_prod?useUnicode=true&amp;characterEncoding=utf8&amp;serverTimezone=GMT%2B8</database.url>
        <database.username>fastddd_user</database.username>
        <database.password>fastddd_password</database.password>
        <redis.host>redis-prod.example.com</redis.host>
        <redis.port>6379</redis.port>
        <enable.swagger>false</enable.swagger>
        <enable.actuator>true</enable.actuator>
      </properties>
    </profile>
    <profile>
      <id>release-artifacts</id>
      <!-- 发布制品 profile：deploy 时附带 sources/javadoc jar（内部 v1.0 起统一启用）。
           仅经 -P 显式激活，日常本地构建不产出。 -->
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <skipIfEmpty>true</skipIfEmpty>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <doclint>none</doclint>
              <encoding>${project.build.sourceEncoding}</encoding>
              <charset>${project.build.sourceEncoding}</charset>
              <docencoding>${project.build.sourceEncoding}</docencoding>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>central</id>
      <!-- Maven Central 发布 profile（镜像 framework 仓同名 profile 形制；Central 不可逆
           故 autoPublish=false 留人工核对门）：GPG 签名于 verify 阶段执行；central-publishing
           以 extensions 接管 deploy 上传 Portal 暂存区。凭证经 publishingServerId=central
           对应 setup-java 注入的 server 凭据（仓库 secrets：CENTRAL_USERNAME/CENTRAL_PASSWORD/
           GPG_*，明文不落仓）。经 .github/workflows/release.yml workflow_dispatch 触发。 -->
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- 0.12.0 参数名（旧名 autoRelease 已移除，显式 false 留人工核对门） -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>checkstyle</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <repositories>
    <repository>
      <id>central</id>
      <name>Maven Central</name>
      <url>https://repo1.maven.org/maven2</url>
    </repository>
    <repository>
      <id>aliyun</id>
      <name>Aliyun Maven Repository</name>
      <url>https://maven.aliyun.com/repository/public</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>central</id>
      <name>Maven Central</name>
      <url>https://repo1.maven.org/maven2</url>
    </pluginRepository>
    <pluginRepository>
      <id>aliyun</id>
      <name>Aliyun Maven Repository</name>
      <url>https://maven.aliyun.com/repository/public</url>
    </pluginRepository>
  </pluginRepositories>
</project>
